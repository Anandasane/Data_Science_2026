   "source": [
    "02  Check even or odd."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "db6a267a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Odd\n"
     ]
    }
   ],
   "source": [
    "n = 7\n",
    "result = \"Even\" if n % 2 == 0 else \"Odd\"\n",
    "print(result)"
   ]
